{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled local control window can request login/status.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-connect",
    "allow-status",
    "allow-qualify",
    "allow-qualify-text",
    "allow-qualify-tools",
    "allow-background",
    "allow-native-discover",
    "allow-native-preflight",
    "allow-native-text",
    "allow-activate-codex",
    "allow-native-cancel",
    "allow-reset-test",
    "allow-installed-list",
    "allow-installed-check",
    "allow-installed-disconnect",
    "allow-installed-retry-web",
    "allow-installed-qualify-reasoning"
  ]
}
